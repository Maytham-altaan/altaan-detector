# =================================================================
#  ALTAAN DETECTOR — environment variables
#  Copy this file to `.env.local` and fill in real values.
#  In Vercel, set these in: Project Settings → Environment Variables.
# =================================================================

# --- Required for sessions (any random ~32-char string) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- App URL (used in magic-link emails and Stripe redirects) ---
# Local: http://localhost:5173    Production: https://your-domain.com
APP_URL=http://localhost:5173

# --- AI provider for the Rewrite Sentence feature ---
# Default: "groq" (free tier, no credit card needed, ~14k requests/day).
# Alternative: "anthropic" (paid Claude API).
LLM_PROVIDER=groq

# --- Groq (default — free tier with very high limits) ---
# Sign up at https://console.groq.com — no credit card required.
# Generate an API key in the console and paste it below.
GROQ_API_KEY=gsk_...

# Optional: override the model. Defaults:
#   groq      → llama-3.3-70b-versatile
#   anthropic → claude-haiku-4-5
# REWRITE_MODEL=llama-3.3-70b-versatile

# --- Anthropic Claude (alternative — paid) ---
# Only needed if LLM_PROVIDER=anthropic. Get from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# --- Vercel KV (persistence) ---
# Create a KV store in Vercel Dashboard → Storage → Create Database
# Vercel auto-injects these when KV is linked to the project; leave blank for
# local in-memory testing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Resend (sign-in emails) ---
# Get from https://resend.com (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=re_...
AUTH_FROM_EMAIL=Altaan Detector <no-reply@your-domain.com>

# --- Stripe (payments) ---
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. After creating the endpoint at
#   https://your-domain.com/api/stripe/webhook, Stripe will give you this.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com → Products
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# --- Usage limits (optional, defaults shown) ---
FREE_WORDS_PER_DAY=200
PREMIUM_WORDS_PER_MONTH=50000

# =================================================================
#  IRAQI MANUAL-APPROVAL PAYMENT FLOW
#  These appear inside the Upgrade modal and on the admin page.
#  Frontend (VITE_*) variables are inlined at build time — set them
#  in Vercel under "Environment Variables" or in the GitHub Actions
#  workflow for GH Pages builds.
# =================================================================

# Your Zain Cash phone number (where customers send payment)
VITE_ZAIN_CASH=0780xxxxxxx

# Your Qi Card number (16 digits)
VITE_QI_CARD=xxxx xxxx xxxx xxxx

# Your bank IBAN + bank name for transfers
VITE_IBAN=IQ00 RAFB 0000 0000 0000 0000
VITE_BANK_NAME=Rafidain Bank

# Telegram handle (without the @) where customers send screenshots
VITE_TELEGRAM=altaan_support

# Price label shown to user (only cosmetic — does not gate anything)
VITE_PRICE_LABEL=7,500 IQD / month

# Admin allowlist — comma-separated emails that can access /admin
# Sign in with any of these emails to see the pending payments page.
ADMIN_EMAILS=your-email@example.com
